      "required": [
        "id",
        "kind",
        "label",
        "form",
        "use_when",
        "examples",
        "contrasts",
        "checks"
      ],
      "title": "Knowledge",
      "type": "object"
    },
    "LessonUnit": {
      "additionalProperties": false,
      "properties": {
        "id": {
