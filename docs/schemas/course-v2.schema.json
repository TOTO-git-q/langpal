    "Example": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "meaning": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "note": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "text",
        "meaning",
        "note"
      ],
      "title": "Example",
      "type": "object"
    },
    "JsonValue": {},
    "Knowledge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "vocabulary",
            "grammar",
            "discourse",
            "pragmatics",
            "strategy",
            "pronunciation",
            "exam_skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "form": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Form",
          "type": "string"
        },
        "use_when": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Use When",
          "type": "string"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Examples",
          "type": "array"
        },
        "contrasts": {
          "items": {
            "$ref": "#/$defs/Contrast"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Contrasts",
          "type": "array"
        },
        "checks": {
          "items": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        }
