{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Criteria",
          "type": "array"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/Probe"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Probes",
          "type": "array"
        },
        "pitfalls": {
          "items": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Pitfalls",
          "type": "array"
        }
      },
      "required": [
        "criteria",
        "probes",
        "pitfalls"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "CanonicalSource": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 600,
          "pattern": "^https?://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "id"
      ],
      "title": "CanonicalSource",
      "type": "object"
    },
    "Contrast": {
      "additionalProperties": false,
      "properties": {
        "alternative": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Alternative",
          "type": "string"
        },
        "distinction": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Distinction",
          "type": "string"
        }
      },
      "required": [
        "alternative",
        "distinction"
      ],
      "title": "Contrast",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "task",
            "meaning",
            "target_use",
            "appropriacy",
            "coherence",
            "interaction",
            "intelligibility"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "knowledge_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Knowledge Ids",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "not_yet": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Not Yet",
          "type": "string"
        },
        "supported": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Supported",
          "type": "string"
        },
        "independent": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Independent",
          "type": "string"
        },
        "flexible": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Flexible",
          "type": "string"
        },
        "requires_audio": {
          "default": false,
          "title": "Requires Audio",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "dimension",
        "knowledge_ids",
        "not_yet",
        "supported",
        "independent",
        "flexible"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Design": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "entry_requirements": {
          "items": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Entry Requirements",
          "type": "array"
        },
        "outcomes": {
          "items": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Outcomes",
          "type": "array"
        },
        "coverage_note": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Coverage Note",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "entry_requirements",
        "outcomes",
        "coverage_note"
