    "TeachingPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_new_points": {
          "default": 1,
          "maximum": 2,
          "minimum": 1,
          "title": "Max New Points",
          "type": "integer"
        },
        "max_review_points": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Review Points",
          "type": "integer"
        },
