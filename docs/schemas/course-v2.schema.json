      "title": "Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CanonicalSource"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "units": {
