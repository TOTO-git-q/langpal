      "maxItems": 120,
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "design": {
      "$ref": "#/$defs/Design"
    },
    "teaching_policy": {
      "$ref": "#/$defs/TeachingPolicy"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    }
