     "practice": {
      "lesson": "writing-build-sentence",
      "title": "10 题 · 6 分钟",
      "brief": [
       "先看句末标点和句首已给出的词。",
       "先找谓语动词，再定主语和宾语。",
       "从句紧跟它修饰的词；间接问句用陈述语序。",
       "排完应恰好剩下一个多余的词块。"
      ],
      "points": {
       "skeleton": "writing-sentence-basic",
       "clause": "writing-sentence-noun-clauses",
       "order": "writing-sentence-modifiers"
      }
     }
