     "title": "邮件　Write an Email",
     "lessons": [
      "writing-email-method",
      "writing-email-structure",
      "writing-email-register",
      "writing-email-functions",
      "writing-email-details",
      "writing-email-errors"
     ],
     "practice": {
      "lesson": "writing-email",
      "title": "1 封 · 7 分钟",
      "brief": [
       "先找出三条要求和收件人。",
       "第一句写明写信目的。",
       "每条要求至少一句，并给出具体信息。",
       "称呼、请求和结尾的语域与收件人一致。",
       "留 1 分钟检查动词时态和拼写。"
      ],
      "points": {
       "coverage": "writing-email-details",
       "register": "writing-email-register",
       "accuracy": "writing-email-errors"
      },
      "venue": "chat"
     }
    },
