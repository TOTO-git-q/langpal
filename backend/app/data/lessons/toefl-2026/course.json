     ],
     "practice": {
      "lesson": "writing-discussion",
      "title": "1 帖 · 10 分钟",
      "brief": [
       "第一句直接回答教授的问题。",
       "一条理由配解释和例子。",
       "提到至少一位同学的观点，并加入新的内容。",
       "不少于 100 词；留 1 分钟检查。"
      ],
      "points": {
