 "title": "动词空位与谓语形式",
 "goal": "区分谓语与非谓语空位并选择适当的动词形式。",
 "skill": "阅读",
 "exam": "大学英语四级（CET-4）",
 "mastery": "once",
 "points": [
  {
   "id": "finite",
   "label": "区分谓语与非谓语空位"
  },
  {
   "id": "form",
   "label": "按助动词和主语选择已有词形"
  }
 ],
 "sources": [
  {
   "id": "c2",
   "title": "全国大学英语四、六级考试大纲（2016年修订版）",
   "url": "https://cet.neea.edu.cn/res/Home/1704/55b02330ac17274664f06d9d3db8249d.pdf",
