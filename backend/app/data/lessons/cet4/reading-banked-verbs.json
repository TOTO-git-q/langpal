   ],
   "groups": [
    {
     "look": "passage",
     "text": "A school garden has a broken fence. A group of students has collected tools for the work. They will repair the fence on Saturday. The teacher plans to bring gloves.",
     "items": [
      {
       "stem": "The students have _____ tools for the work.",
       "options": [
        "collect",
        "collected",
        "collecting",
        "collects"
       ],
       "answer": 1,
       "why": "原文是 has collected tools for the work。have 后接过去分词 collected。",
       "point": "form"
      },
      {
       "stem": "The teacher plans to _____ gloves.",
       "options": [
        "brought",
        "bringing",
        "bring",
        "brings"
       ],
       "answer": 2,
       "why": "plans 是谓语，to 后接原形 bring。",
       "point": "finite"
      }
     ]
    }
   ]
  },
