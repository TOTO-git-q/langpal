       "stem": "The group discussed the _____ of the garden.",
       "options": [
        "development",
        "develop",
        "developed",
        "developing"
       ],
       "answer": 0,
       "why": "the 后需要名词；development 表示发展。",
       "point": "suffix"
      },
      {
       "stem": "The town plans to _____ the old library.",
       "options": [
        "modern",
        "modernize",
        "modernity",
        "modernization"
       ],
       "answer": 1,
       "why": "plans to 后用动词原形；modernize 表示使现代化。",
       "point": "suffix"
      },
      {
       "stem": "The guide gave a _____ explanation.",
       "options": [
        "help",
        "helped",
        "helpful",
        "helpfully"
       ],
       "answer": 2,
       "why": "explanation 前用形容词 helpful。",
       "point": "context"
      },
      {
       "stem": "The teacher spoke _____ to the class.",
       "options": [
        "clear",
        "cleared",
        "clarity",
        "clearly"
       ],
       "answer": 3,
       "why": "副词 clearly 修饰 spoke。",
       "point": "context"
      },
      {
       "stem": "The _____ provides free classes.",
       "options": [
        "organization",
        "organize",
        "organized",
        "organizing"
       ],
       "answer": 0,
       "why": "The 后的空位是主语；organization 是名词。",
       "point": "suffix"
      },
      {
       "stem": "The switch will _____ the light.",
       "options": [
        "activity",
        "activate",
        "active",
        "activation"
       ],
       "answer": 1,
       "why": "will 后接动词原形 activate。",
       "point": "context"
      }
     ]
    }
   ]
