  "cards": [
    {
      "id": "timed",
      "type": "quiz",
      "title": "小测",
      "minutes": 3,
      "points": [
        "onkun",
        "sound"
      ],
      "sets": [
        {
          "id": "set-a",
          "groups": [
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "長年の交渉が実を結び、両社はようやく【合併】に踏み切った。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "がっぺい",
                    "がつへい",
                    "ごうへい",
                    "がっへい"
                  ],
                  "answer": 0,
                  "why": "「合併」读作「がっぺい」，要保留促音和半浊音。",
                  "point": "sound"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "古い記録を丹念に調べ、町の変遷を【辿る】作業を続けた。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "さぐる",
                    "たどる",
                    "めぐる",
                    "なぞる"
                  ],
                  "answer": 1,
                  "why": "「辿る」读作「たどる」，表示追溯；「さぐる」对应「探る」。",
                  "point": "onkun"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "講師は質問の意図を【察し】、説明の順序を変えてくれた。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "さつし",
                    "さし",
                    "さっし",
                    "ざっし"
                  ],
                  "answer": 2,
                  "why": "「察し」读作「さっし」，「察する」的连用形保留促音。",
                  "point": "sound"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "職人は道具のわずかな傷みも見逃さず、丁寧に【繕った】。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "よそおった",
                    "おぎなった",
                    "ととのった",
                    "つくろった"
                  ],
                  "answer": 3,
                  "why": "「繕った」读作「つくろった」，表示修补；「よそおった」是「装った」。",
                  "point": "onkun"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "経験の有無を問わず、応募者には【均等】に機会が与えられる。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "きんとう",
                    "きんと",
                    "きとう",
                    "ぎんとう"
                  ],
                  "answer": 0,
                  "why": "「均等」读作「きんとう」，「とう」的长音不能省略。",
                  "point": "sound"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "集会所の【傍ら】には、住民が手入れしている小さな花壇がある。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "そばら",
                    "かたわら",
                    "はたら",
                    "かたよら"
                  ],
                  "answer": 1,
                  "why": "「傍ら」读作「かたわら」，指旁边，不能按单字拼读。",
                  "point": "onkun"
                }
              ]
            }
          ]
        },
        {
          "id": "set-b",
          "groups": [
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "資料の公開を求める声に対し、委員会は【慎重】な姿勢を示した。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "しんちょう",
                    "しんちょ",
                    "しんじょう",
                    "しちょう"
                  ],
                  "answer": 0,
                  "why": "「慎重」读作「しんちょう」，末尾是长音，不能读成「しんちょ」。",
                  "point": "sound"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "この工房では、材料の特徴を生かす技術を長年【培って】きた。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "あつかって",
                    "つちかって",
                    "うやまって",
                    "やしなって"
                  ],
                  "answer": 1,
                  "why": "「培って」读作「つちかって」，表示长期培养、积累。",
                  "point": "onkun"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "調査の条件が変われば、結論の【根拠】も改めて確認する必要がある。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "こんきょう",
                    "ごんきょ",
                    "こんきょ",
                    "こんこ"
                  ],
                  "answer": 2,
                  "why": "「根拠」读作「こんきょ」，「拠」不带长音。",
                  "point": "sound"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "責任の所在を【曖昧】にしたままでは、同じ問題が再び起こる。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "あいみ",
                    "あんまい",
                    "あまい",
                    "あいまい"
                  ],
                  "answer": 3,
                  "why": "「曖昧」读作「あいまい」，两字都须完整读出。",
                  "point": "onkun"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "避難路の安全を確かめるため、通路の幅を【測った】。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "はかった",
                    "さぐった",
                    "うかがった",
                    "たどった"
                  ],
                  "answer": 0,
                  "why": "「測った」读作「はかった」，这里指测量通路宽度。",
                  "point": "onkun"
                }
              ]
            },
            {
              "label": "次の文の【 】をつけた言葉の読み方を選びなさい。",
              "look": "passage",
              "text": "何度も修正を重ね、担当者は企画書の完成に【執着】した。",
              "items": [
                {
                  "stem": "【 】の言葉の読み方として最もよいものはどれか。",
                  "options": [
                    "しゅちゃく",
                    "しゅうちゃく",
                    "しっちゃく",
                    "しゅうじゃく"
                  ],
                  "answer": 1,
                  "why": "「執着」读作「しゅうちゃく」，「しゅう」是长音。",
                  "point": "sound"
                }
              ]
            }
          ]
        }
      ],
      "more": {
        "kind": "vocab-reading",
        "topics": [
