  "cards": [
    {
      "id": "timed",
      "type": "quiz",
      "title": "小测",
      "minutes": 6,
      "points": [
        "pair",
        "scope",
        "whole"
      ],
      "sets": [
        {
          "id": "set-a",
          "groups": [
            {
              "label": "文が自然につながるように語句を並べなさい。",
              "look": "passage",
              "text": "",
              "items": [
                {
                  "stem": "報告書をいつ提出しますか。",
                  "lead": "報告書は、",
                  "chunks": [
                    "関係者全員の",
                    "了承を",
                    "得た",
                    "上で"
                  ],
                  "tail": "正式に提出することになっています。",
                  "extra": [
                    "得る"
                  ],
                  "why": "「関係者全員の」修饰「了承」，「了承を得た上で」接后项；「上で」要求已完成的「得た」。",
                  "point": "pair"
                },
                {
                  "stem": "採用された案にはどんな特徴がありますか。",
                  "lead": "今回採用されたのは、",
                  "chunks": [
                    "利用者が",
                    "不便だと",
                    "感じている点を",
                    "解消するための"
                  ],
                  "tail": "具体的な改善案です。",
                  "extra": [
                    "解消するので"
                  ],
                  "why": "「利用者が不便だと感じている点」整体作「解消する」的宾语；「ための」修饰末尾的名词。",
                  "point": "scope"
                },
                {
                  "stem": "調査を続ける意味はありますか。",
                  "lead": "この調査は、",
                  "chunks": [
                    "続ければ",
                    "続ける",
                    "ほど",
                    "新たな疑問が"
                  ],
                  "tail": "生じるので、結論を急げません。",
                  "extra": [
                    "続けた"
                  ],
                  "why": "「続ければ続けるほど」构成固定呼应，后接「疑問が生じる」；「続けた」不能替代辞书形。",
                  "point": "pair"
                },
                {
                  "stem": "計画を変更する理由は何ですか。",
                  "lead": "計画の変更を求めるのは、",
                  "chunks": [
                    "住民の安全を",
                    "確保する",
                    "ことが",
                    "何よりも"
                  ],
                  "tail": "重要だと考えているからです。",
                  "extra": [
                    "確保して"
                  ],
                  "why": "「安全を確保すること」是名词化主语，接「が何よりも重要」；「確保してこと」不成立。",
                  "point": "whole"
                },
                {
                  "stem": "展示の準備で何に困りましたか。",
                  "lead": "最も困難だったのは、",
                  "chunks": [
                    "保存状態の",
                    "悪い資料を",
                    "傷つけずに",
                    "展示するための"
                  ],
                  "tail": "方法を見つけることでした。",
                  "extra": [
                    "展示するから"
                  ],
                  "why": "「保存状態の悪い」修饰资料，「傷つけずに展示するための」修饰方法；extra不能接「方法」。",
                  "point": "scope"
                }
              ]
            }
          ]
        },
        {
          "id": "set-b",
          "groups": [
            {
              "label": "文が自然につながるように語句を並べなさい。",
              "look": "passage",
              "text": "",
              "items": [
                {
                  "stem": "会場の利用は誰でも申し込めますか。",
                  "lead": "会場を利用するには、",
                  "chunks": [
                    "登録を",
                    "済ませた",
                    "人に",
                    "限り"
                  ],
                  "tail": "申込みが認められるという条件があります。",
                  "extra": [
                    "済ませると"
                  ],
                  "why": "「登録を済ませた人に限り」限定申请资格；「済ませると人」不成立。",
                  "point": "pair"
                },
                {
                  "stem": "委員会はなぜ判断を保留したのですか。",
                  "lead": "委員会が重視したのは、",
                  "chunks": [
                    "提案された",
                    "方法が",
                    "実際に役立つか",
                    "どうかという"
                  ],
                  "tail": "点であり、見栄えではありません。",
                  "extra": [
                    "どうしてという"
                  ],
                  "why": "「方法が役立つかどうか」构成间接疑问，「という」修饰「点」；「どうして」不接「か」。",
                  "point": "scope"
                },
                {
                  "stem": "資料を集めれば十分ですか。",
                  "lead": "資料は、",
                  "chunks": [
                    "集めさえ",
                    "すれば",
                    "よいという",
                    "ものでは"
                  ],
                  "tail": "なく、その信頼性を確かめる必要があります。",
                  "extra": [
                    "するなら"
                  ],
                  "why": "「さえすれば」与「よいというものではなく」相接；不能用「するなら」替代固定条件形式。",
                  "point": "whole"
                },
                {
                  "stem": "現場からどのような意見が出ましたか。",
                  "lead": "現場から出たのは、",
                  "chunks": [
                    "経験の",
                    "浅い職員でも",
                    "迷わず使える",
                    "ような"
                  ],
                  "tail": "手引きが必要だという意見でした。",
                  "extra": [
                    "ように"
                  ],
                  "why": "「経験の浅い職員でも迷わず使える」整体修饰手引き；名词前接「ような」而非「ように」。",
                  "point": "scope"
                },
                {
                  "stem": "同じ失敗を繰り返さないために何をしますか。",
                  "lead": "同じ失敗を繰り返さないためには、",
                  "chunks": [
                    "原因を",
                    "明らかにした",
                    "上で",
                    "対策を"
                  ],
                  "tail": "講じる必要があると考えています。",
                  "extra": [
                    "明らかにして"
                  ],
                  "why": "「原因を明らかにした上で」要求完成分析之后再采取措施；「して上で」接续错误。",
                  "point": "pair"
                }
              ]
            }
          ]
        }
      ],
      "more": {
        "kind": "grammar-order",
        "topics": [
          "地域の資料保存",
          "職場の引き継ぎ",
          "図書館の利用",
          "展示の企画",
          "学習方法の見直し",
          "道具の修理",
          "共同作業の分担",
          "施設の予約",
          "読書会の運営",
          "商品の包装",
          "研修への参加",
          "町の案内づくり"
        ]
      },
      "pass": 0.8
    }
  ]
}
