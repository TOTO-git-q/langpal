  "cards": [
    {
      "id": "timed",
      "type": "quiz",
      "title": "小测",
      "minutes": 3,
      "points": [
        "synonym",
        "nuance",
        "idiom"
      ],
      "sets": [
        {
          "id": "set-a",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "資料の不足を補うため、調査の対象地域をさらに【拡充した】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "広げて充実させた",
                    "狭めて重点を絞った",
                    "変えずに維持した",
                    "別の地域に移した"
                  ],
                  "answer": 0,
                  "why": "「拡充」兼有扩大和充实之意，并非只迁移对象。",
                  "point": "synonym"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "作業の遅れを取り戻そうと、彼は同僚に協力を【促した】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "義務づけた",
                    "働きかけた",
                    "断念させた",
                    "拒絶した"
                  ],
                  "answer": 1,
                  "why": "「促す」是促使对方行动，不等于强制规定为义务。",
                  "point": "synonym"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "提案された方法は【巧妙で】、複雑な問題を見事に解決した。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "手間がかからなくて",
                    "誰でも知っていて",
                    "よく工夫されていて",
                    "危険を伴っていて"
                  ],
                  "answer": 2,
                  "why": "这里称赞设计巧妙，不能扩大为省事或人人皆知。",
                  "point": "nuance"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "条件を何度説明しても、担当者の態度は【頑なだった】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "すぐに不安になった",
                    "相手に気を配った",
                    "判断を保留した",
                    "自分の考えを変えなかった"
                  ],
                  "answer": 3,
                  "why": "「頑な」强调固执不变，不是暂缓判断。",
                  "point": "nuance"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "新しい装置は故障が多く、修理担当者も【手を焼いている】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "扱いに困っている",
                    "作業を急いでいる",
                    "費用を節約している",
                    "危険を知らせている"
                  ],
                  "answer": 0,
                  "why": "「手を焼く」表示难以应付，不是字面上的烧伤或赶工。",
                  "point": "idiom"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "彼はこの業界で【顔が利く】ので、適任者をすぐに紹介してくれた。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "外見だけで判断できる",
                    "人脈があり融通が利く",
                    "人の顔をよく覚える",
                    "表情を読み取れる"
                  ],
                  "answer": 1,
                  "why": "「顔が利く」指有人脉、能获得帮助，不是辨认面孔。",
                  "point": "idiom"
                }
              ]
            }
          ]
        },
        {
          "id": "set-b",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "資料の書式を統一するにあたり、前年の方式を【踏襲した】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "そのまま受け継いだ",
                    "根本から改めた",
                    "一部だけ取り消した",
                    "欠点を公表した"
                  ],
                  "answer": 0,
                  "why": "「踏襲」表示沿用原有方式，不是修改或取消。",
                  "point": "synonym"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "議論が停滞したため、司会者が論点を【整理し直した】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "すべて結論づけた",
                    "改めて筋道を整えた",
                    "関係のない話を加えた",
                    "発言を禁止した"
                  ],
                  "answer": 1,
                  "why": "整理论点是重新梳理，不等于为全部争论下结论。",
                  "point": "synonym"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "彼の報告には【緻密な】検討の跡があり、細部にも抜けがない。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "時間をかけずに済ませた",
                    "大まかな点だけ押さえた",
                    "細かい所まで行き届いた",
                    "独自性を最優先にした"
                  ],
                  "answer": 2,
                  "why": "「緻密」强调细致周密，与后文没有疏漏相应。",
                  "point": "nuance"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "説明が【疎かに】された結果、参加者の間に誤解が広がった。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "詳しすぎるほど行われて",
                    "何度も繰り返されて",
                    "順序を変えて行われて",
                    "十分に行われずに"
                  ],
                  "answer": 3,
                  "why": "「疎かにする」表示不认真对待；不指说明过细。",
                  "point": "nuance"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "予定外の支出が重なり、今回の催しでは結局【足が出た】。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "予算を超えてしまった",
                    "参加者が減ってしまった",
                    "開催が遅れてしまった",
                    "計画が漏れてしまった"
                  ],
                  "answer": 0,
                  "why": "「足が出る」在支出语境中指超出预算，不是活动延期。",
                  "point": "idiom"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "意見が違っても率直に話せる彼は、私には【気が置けない】友人だ。",
              "items": [
                {
                  "stem": "【 】の言葉に最も近い意味のものはどれか。",
                  "options": [
                    "油断できず警戒が必要な",
                    "遠慮せずに付き合える",
                    "いつも気を配る必要のある",
                    "長く会えず心配な"
                  ],
                  "answer": 1,
                  "why": "「気が置けない」表示无需拘谨，不能按字面误解为需要提防。",
                  "point": "idiom"
                }
              ]
            }
          ]
        }
      ],
