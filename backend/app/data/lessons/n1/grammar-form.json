  "cards": [
    {
      "id": "timed",
      "type": "quiz",
      "title": "小测",
      "minutes": 6,
      "points": [
        "pattern",
        "connection",
        "register"
      ],
      "sets": [
        {
          "id": "set-a",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "事情を知らなかった（　）、関係者に確認せず資料を公開した責任は免れない。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "とはいえ",
                    "からこそ",
                    "ばかりに",
                    "に先立ち"
                  ],
                  "answer": 0,
                  "why": "「とはいえ」承认不知情这一事实后提出保留；「からこそ」会把不知情变成追责理由。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "主催者として引き受けた（　）、最後まで責任を持って準備に当たるつもりだ。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "かたわら",
                    "からには",
                    "そばから",
                    "にひきかえ"
                  ],
                  "answer": 1,
                  "why": "「からには」表示既然承担就应负责；「そばから」表示刚做就又发生。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "期待されていた新製品だったが、発売（　）、不具合が見つかって回収された。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "次第",
                    "かたがた",
                    "早々",
                    "ながらも"
                  ],
                  "answer": 2,
                  "why": "名词「発売」可接「早々」，表示刚上市就发生问题；这里不能接连用形后的「次第」。",
                  "point": "connection"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "長時間に及んだ会議が終わる（　）、参加者は質問のために講師の周りへ一斉に集まった。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "べく",
                    "まじき",
                    "ともなく",
                    "や否や"
                  ],
                  "answer": 3,
                  "why": "「辞书形＋や否や」表示紧接发生的过去事件；「べく」表示目的。",
                  "point": "connection"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "先生、先日お借りした資料を返しに、明日の午後そちらへ（　）よろしいでしょうか。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "伺っても",
                    "参られても",
                    "おいでになっても",
                    "ご覧になっても"
                  ],
                  "answer": 0,
                  "why": "说话人自己去老师处用谦让语「伺う」；尊敬语不能抬高自己的动作。",
                  "point": "register"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "本日は遠いところをわざわざ（　）、誠にありがとうございますと司会者が述べた。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "お越しくださりになり",
                    "お越しいただき",
                    "参っていただかれ",
                    "伺わせになり"
                  ],
                  "answer": 1,
                  "why": "「お越しいただき」表示承蒙对方前来；其余是敬语结构混用。",
                  "point": "register"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "本人が強く希望しているのであれば、周囲が無理に引き止める（　）だろう。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "にたえない",
                    "に即している",
                    "には及ばない",
                    "に先立っている"
                  ],
                  "answer": 2,
                  "why": "「引き止めるには及ばない」表示没有必要；「にたえない」不表达免除必要性。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "細部にこだわって修正を重ねる（　）、提出期限を過ぎてしまっては意味がない。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "限り",
                    "ついでに",
                    "に応じて",
                    "あまり"
                  ],
                  "answer": 3,
                  "why": "「〜あまり」引出过度投入造成的负面结果；「ついでに」不能表达这种因果。",
                  "point": "pattern"
                }
              ]
            }
          ]
        },
        {
          "id": "set-b",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "どれほど経験を積んだ専門家（　）、資料なしで正確な結論を出すのは難しい。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "であれ",
                    "につれて",
                    "をおいて",
                    "に先駆け"
                  ],
                  "answer": 0,
                  "why": "「名词＋であれ」表示即便是某种身份也不例外，与「どれほど」相应。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "重大な手続きの誤りが判明した以上、担当者は謝罪するだけでは（　）だろう。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "かなわない",
                    "済まない",
                    "たまらない",
                    "やまない"
                  ],
                  "answer": 1,
                  "why": "「〜だけでは済まない」表示仅道歉还不足以了结；其他选项不能表达这一限制。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "目的地の駅に着く（　）、同行していた友人は忘れ物に気づいて家へ引き返した。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "あまり",
                    "べく",
                    "なり",
                    "まじく"
                  ],
                  "answer": 2,
                  "why": "「辞书形＋なり」连接紧接发生的事件，后项是过去事实；「べく」是目的。",
                  "point": "connection"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "来年度の新制度の導入に（　）、利用者を対象とした説明会を来週開催する予定だ。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "伴った末に",
                    "即したまま",
                    "際したほど",
                    "先立って"
                  ],
                  "answer": 3,
                  "why": "「に先立って」表示在引入制度之前，符合提前说明的顺序。",
                  "point": "connection"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "初めてお目にかかります。新しい担当者の林と（　）。どうぞよろしくお願いいたします。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "申します",
                    "おっしゃいます",
                    "申し上げられます",
                    "お呼びになります"
                  ],
                  "answer": 0,
                  "why": "自我介绍用「申します」，「おっしゃいます」用于尊称别人的话语。",
                  "point": "register"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "長年付き合いのある取引先から部長宛ての電話を受け、部下は「部長はただ今（　）」と答えた。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "席を外していらっしゃいます",
                    "席を外しております",
                    "お席を外されてございます",
                    "席を外してくださいます"
                  ],
                  "answer": 1,
                  "why": "对外说明本公司上司的状态，用「おります」；不能对外抬高己方上司。",
                  "point": "register"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "この企画に参加するかどうかは本人の自由であり、周囲が結論を急がせる（　）。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "に違いない",
                    "にほかならない",
                    "べきではない",
                    "までのことだ"
                  ],
                  "answer": 2,
                  "why": "前文确认个人自由，后文应否定强迫；「に違いない」会断言别人必然催促。",
                  "point": "pattern"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "調査で決定的な証拠が示された今となっては、以前の説明を撤回（　）だろう。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "せずにはいられない",
                    "するまでもない",
                    "するには当たらない",
                    "せざるを得ない"
                  ],
                  "answer": 3,
                  "why": "证据使撤回成为不得不做的事；「ずにはいられない」偏向内在冲动。",
                  "point": "pattern"
                }
              ]
            }
          ]
        }
      ],
