  "cards": [
    {
      "id": "timed",
      "type": "quiz",
      "title": "小测",
      "minutes": 4,
      "points": [
        "meaning",
        "adverb",
        "collocation"
      ],
      "sets": [
        {
          "id": "set-a",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "反対意見にも耳を傾けた結果、当初の計画は大幅な（　）を迫られた。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "修正",
                    "修復",
                    "復旧",
                    "補給"
                  ],
                  "answer": 0,
                  "why": "计划内容的改动用「修正」；「修復」「復旧」用于修好或恢复。",
                  "point": "meaning"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "彼の説明は（　）として要領を得ず、何を求めているのか分からない。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "整然",
                    "漠然",
                    "毅然",
                    "断然"
                  ],
                  "answer": 1,
                  "why": "「漠然として」表示含糊，与「要領を得ず」相应；「整然」表示有条理。",
                  "point": "meaning"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "実績が豊富な人の助言が、初心者にも（　）当てはまるとは限らない。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "いっそ",
                    "ひたすら",
                    "必ずしも",
                    "せめて"
                  ],
                  "answer": 2,
                  "why": "「必ずしも〜とは限らない」表示不一定，其他副词不能表达这一限定。",
                  "point": "adverb"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "新しい案には欠点もあるが、旧案より費用が（　）少なくて済む。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "ろくに",
                    "一向に",
                    "むやみに",
                    "はるかに"
                  ],
                  "answer": 3,
                  "why": "「はるかに」加强比较的差距；「ろくに」「一向に」通常与否定呼应。",
                  "point": "adverb"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "担当者が休職するため、進行中の案件を私が一括して（　）ことになった。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "引き継ぐ",
                    "取り締まる",
                    "引き止める",
                    "取り巻く"
                  ],
                  "answer": 0,
                  "why": "接手进行中的工作用「案件を引き継ぐ」；「取り締まる」是管制、查处。",
                  "point": "collocation"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "相手の説明に矛盾がないか、細かな点まで注意深く（　）必要がある。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "遠慮する",
                    "吟味する",
                    "弁償する",
                    "介抱する"
                  ],
                  "answer": 1,
                  "why": "审查说明是否有矛盾用「吟味する」；其他词不表示审查内容。",
                  "point": "collocation"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "作業が遅れた理由を尋ねると、彼は責任を他部署に（　）発言を繰り返した。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "還元する",
                    "調達する",
                    "転嫁する",
                    "蓄積する"
                  ],
                  "answer": 2,
                  "why": "「責任を転嫁する」表示把责任推给别人；「還元する」是返还或还原。",
                  "point": "collocation"
                }
              ]
            }
          ]
        },
        {
          "id": "set-b",
          "groups": [
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "説明を聞かずに契約したのだから、損失が出ても（　）だと彼は言う。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "自業自得",
                    "試行錯誤",
                    "臨機応変",
                    "本末転倒"
                  ],
                  "answer": 0,
                  "why": "自己不听说明而承担后果，对应「自業自得」；「本末転倒」强调主次颠倒。",
                  "point": "meaning"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "住民の意見を聞く会のはずが、主催者の説明だけで終わり、（　）を感じた。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "使命感",
                    "違和感",
                    "達成感",
                    "親近感"
                  ],
                  "answer": 1,
                  "why": "名义与实际不符产生不协调的感觉，选「違和感」，不是完成任务的满足感。",
                  "point": "meaning"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "十分に検討した案だったが、審査では（　）問題点ばかり指摘された。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "おのずと",
                    "かろうじて",
                    "ことごとく",
                    "あらかじめ"
                  ],
                  "answer": 2,
                  "why": "「ことごとく」表示无一例外，与「問題点ばかり」相应；「あらかじめ」表示事前。",
                  "point": "adverb"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "誰に頼まれたわけでもないのに、彼は（　）準備の手伝いを申し出た。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "おおむね",
                    "もっぱら",
                    "およそ",
                    "自ら"
                  ],
                  "answer": 3,
                  "why": "无人请求而主动提出，用「自ら」；「もっぱら」表示专门，不能表达主动性。",
                  "point": "adverb"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "交渉が難航しても、双方は対話を続け、解決への道を（　）とした。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "探ろう",
                    "誇ろう",
                    "阻もう",
                    "拒もう"
                  ],
                  "answer": 0,
                  "why": "「解決への道を探る」表示探索解决办法；「阻む」与继续对话求解的方向相反。",
                  "point": "collocation"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "調査で得られた資料を年代順に（　）ことで、変化の過程が見えてきた。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "処分する",
                    "整理する",
                    "辞退する",
                    "放棄する"
                  ],
                  "answer": 1,
                  "why": "按年代排列资料用「整理する」；处置或放弃资料无法由此看出变化过程。",
                  "point": "collocation"
                }
              ]
            },
            {
              "label": "次の文章を読んで、後の問いに答えなさい。",
              "look": "passage",
              "text": "決定を急ぐあまり、利用者の小さな不満を（　）にしてはならない。",
              "items": [
                {
                  "stem": "（　）に入れるのに最もよいものはどれか。",
                  "options": [
                    "うろ覚え",
                    "手遅れ",
                    "ないがしろ",
                    "うってつけ"
                  ],
                  "answer": 2,
                  "why": "「不満をないがしろにする」表示轻视；其他词不能与这里的「を〜にする」表达同义。",
                  "point": "collocation"
                }
              ]
            }
          ]
        }
      ],
      "more": {
